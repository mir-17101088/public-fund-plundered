{
  "cleanUrls": true,
  "headers": [
    { "source": "/(fonts|vendor)/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/(img|media)/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] },
    { "source": "/(.*)", "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }, { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }] },
    { "source": "/(.*)", "has": [{ "type": "host", "value": { "suf": ".vercel.app" } }], "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] }
  ]
}
